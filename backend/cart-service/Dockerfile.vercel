# Vercel-compatible Dockerfile for Cart Service
# Uses lightweight alpine base with minimal layers for fast deployments

FROM eclipse-temurin:21-jdk-alpine as builder

WORKDIR /build

# Install Maven and Git
RUN apk add --no-cache maven git

# Copy pom.xml first
COPY pom.xml .

# Clone or fetch common-exceptions from the repository
# This ensures we have the dependency available during build
RUN git clone --depth 1 https://github.com/mdaazam0786/Food-Delievery-App.git /tmp/foodzie-repo && \
    cd /tmp/foodzie-repo/backend/common-exceptions && \
    mvn clean install -q -DskipTests && \
    cd /build

# Download dependencies (cache layer)
RUN mvn dependency:go-offline -B

# Copy source code
COPY src ./src

# Build application
RUN mvn clean package -DskipTests -q

# Runtime stage - Alpine Linux for minimal size
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy JAR from builder
COPY --from=builder /build/target/*.jar app.jar

# Health check (default port 8086, override with PORT env var)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget -q -O - http://localhost:${PORT:-8086}/actuator/health | grep -q UP || exit 1

# Expose default port (can be overridden by PORT environment variable at runtime)
EXPOSE 8086

# Run application with dynamic PORT environment variable
# The PORT env var is read from Vercel at runtime
CMD ["sh", "-c", "java -jar app.jar --server.port=${PORT:-8086}"]
