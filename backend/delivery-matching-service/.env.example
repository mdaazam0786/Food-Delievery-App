# Delivery Matching Service - Environment Variables Template
# Copy this file to .env and fill in actual values for your deployment
# NEVER commit actual secrets to git

# ── Eureka Service Discovery ──────────────────────────────────────────────────
# URL of the Eureka server for service registration and discovery
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=https://your-eureka-server.com/eureka/

# Hostname for this service instance in Eureka (typically your deployment domain)
DELIVERY_MATCHING_SERVICE_HOST=delivery-matching-service.yourdomain.com

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB connection URI with authentication
# Format: mongodb+srv://username:password@host/database?options
# Example: mongodb+srv://user:pass@cluster0.mongodb.net/foodzie?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/foodzie?retryWrites=true&w=majority

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL for geospatial data and driver heartbeats
# Format: redis://[password@]host[:port][/db]
# Example: redis://:password@redis.yourdomain.com:6379/0
SPRING_DATA_REDIS_URL=redis://your-password@redis-host:6379/0

# ── JWT Secret Key ────────────────────────────────────────────────────────────
# Base64-encoded JWT secret key for token validation (256-bit minimum recommended)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-jwt-secret-key-here

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Kafka bootstrap servers (comma-separated for multiple brokers)
# Local: kafka:9092
# Aiven Free: kafka-xxxxxx.a.aivencloud.com:9092
# AWS MSK: b-1.cluster.xxxxx.kafka.us-east-1.amazonaws.com:9092,b-2.cluster.xxxxx.kafka.us-east-1.amazonaws.com:9092
KAFKA_BOOTSTRAP_SERVERS=kafka-xxxxxx.a.aivencloud.com:9092

# Kafka SASL/SSL credentials (if required by your Kafka cluster)
# Leave empty if using PLAINTEXT security.protocol
# KAFKA_SASL_USERNAME=your-kafka-username
# KAFKA_SASL_PASSWORD=your-kafka-password

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS requests
# Example: http://localhost:3000,http://localhost:3001,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.yourdomain.com

# ── Application Logging ───────────────────────────────────────────────────────
# Logging levels: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_COM_FOODZIE=DEBUG
LOG_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO

# ── Monitoring & Health ───────────────────────────────────────────────────────
# Actuator endpoints exposure (comma-separated)
# Production: health,info
# Development: health,info,metrics,prometheus
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# ── Server Configuration ──────────────────────────────────────────────────────
# Server port
SERVER_PORT=8092

# ── JVM Configuration (Docker/Kubernetes) ─────────────────────────────────────
# Memory allocation (set in Dockerfile ENTRYPOINT or container limits)
# Example: java -Xms256m -Xmx512m -jar app.jar
# JAVA_OPTS=-Xms256m -Xmx512m

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Matching algorithm parameters
APP_MATCHING_INITIAL_RADIUS_KM=3.0
APP_MATCHING_RADIUS_STEPS=3.0,5.0,8.0,10.0
APP_MATCHING_MAX_CANDIDATES=5
