# Vercel-compatible Dockerfile for Search Service
# Uses lightweight alpine base with minimal layers for fast deployments
# Note: Requires full monorepo context for building (common-exceptions dependency)

FROM eclipse-temurin:21-jdk-alpine as builder

WORKDIR /build

# Install Maven
RUN apk add --no-cache maven

# Copy the entire backend directory structure to ensure common-exceptions is available
# This assumes the build context is set from the repository root
COPY backend ./

# Install common-exceptions module first
WORKDIR /build/common-exceptions
RUN mvn clean install -q

# Build search-service
WORKDIR /build/search-service
RUN mvn clean package -DskipTests -q

# Runtime stage - Alpine Linux for minimal size
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy JAR from builder
COPY --from=builder /build/search-service/target/*.jar app.jar

# Health check (default port 8089, override with PORT env var)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget -q -O - http://localhost:${PORT:-8089}/actuator/health | grep -q UP || exit 1

# Expose default port (can be overridden by PORT environment variable at runtime)
EXPOSE 8089

# Run application with dynamic PORT environment variable
# The PORT env var is read from Vercel at runtime
CMD ["sh", "-c", "java -jar app.jar --server.port=${PORT:-8089}"]
